  m_text: "\u0E15\u0E31\u0E27\u0E40\u0E01\u0E21\u0E2A\u0E4C\u0E21\u0E35\u0E2B\u0E49\u0E2D\u0E07\u0E43\u0E2B\u0E49\u0E25\u0E39\u0E01\u0E04\u0E49\u0E32\u0E40\u0E25\u0E48\u0E19
